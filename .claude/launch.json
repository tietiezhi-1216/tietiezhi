{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop-electron",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "app",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000",
        "--directory",
        "website/public"
      ],
      "port": 8000
    }
  ]
}
