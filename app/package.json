{
  "name": "tietiezhi-app",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "铁铁汁 Electron 宿主：统一渲染多个 ACP 核心",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test:agent": "tsc -p tsconfig.test.json && node --test .test-out/main/agent/"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@ai-sdk/anthropic": "4.0.24",
    "@ai-sdk/google": "4.0.28",
    "@ai-sdk/openai": "4.0.24",
    "ai": "7.0.42",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^40.0.0",
    "electron-vite": "6.0.0-beta.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
