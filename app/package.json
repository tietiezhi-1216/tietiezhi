{
  "name": "tietiezhi-app",
  "private": true,
  "version": "0.4.6",
  "license": "Apache-2.0",
  "author": "Tietiezhi",
  "type": "module",
  "description": "Tietiezhi Electron 桌面 AI 应用",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && electron-vite build",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac:arm64": "pnpm build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "pnpm build && electron-builder --mac --x64 --publish never",
    "dist:win": "pnpm build && electron-builder --win --x64 --publish never",
    "smoke:package": "node scripts/package-smoke.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/main/**/*.test.ts",
    "test:renderer": "vitest run",
    "test:all": "pnpm test && pnpm test:renderer",
    "verify": "pnpm typecheck && pnpm test:all && pnpm build",
    "version:timestamp": "node scripts/set-release-version.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.24",
    "@ai-sdk/google": "4.0.28",
    "@ai-sdk/openai": "4.0.24",
    "ai": "7.0.42",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "6.8.9",
    "lucide-react": "1.24.0",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^40.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.tietiezhi.desktop",
    "productName": "Tietiezhi",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "../assets/brand"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "tietiezhi-mark-macos.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "electronUpdaterCompatibility": ">=2.16"
    },
    "win": {
      "icon": "tietiezhi-mark.png",
      "target": [
        "nsis"
      ],
      "electronUpdaterCompatibility": ">=2.16"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tietiezhi-1216",
        "repo": "tietiezhi",
        "releaseType": "release"
      }
    ]
  }
}
