{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-out",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/main/agent/**/*.ts", "src/shared/**/*.ts"],
  // The agent core is tested in isolation. `wiring.ts` and `commands.ts` are the
  // seams to settings and Electron; pulling them in would drag the whole host
  // tree into a stricter module resolution than the app build uses, and neither
  // is under test — the tests inject their own key resolver and approval gate.
  "exclude": ["src/main/agent/wiring.ts", "src/main/agent/commands.ts"]
}
